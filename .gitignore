# Local database backups/exports — may contain real user data.
# (database/tindago_schema.sql is the app's schema+seed source, not a
# live-data dump, so it's intentionally NOT excluded here.)
/referral_platform_backup.sql
/database/backups/
# One-off live scripts that embed password hashes or other real
# member/admin PII (names, addresses) — keep local, run in phpMyAdmin,
# never commit.
/database/live_reset_basics_passwords.sql
/database/live_add_basics_super_admin.sql
/database/live_migrate_account_separation.sql
/database/live_migrate_basics_admin_only.sql
/database/live_fix_basics_user_structured_fields.sql

# Real DB credentials (local root/no-password is harmless, but this file
# now also holds the live production password) — never track this file.
# See config/database.example.php for the structure to recreate it.
config/database.php

# Real Semaphore SMS API key — never track this file.
# See config/sms.example.php for the structure to recreate it.
config/sms.php

# Real Gmail SMTP app password — never track this file.
# See config/email.example.php for the structure to recreate it.
config/email.php

# Real Google Gemini API key — never track this file.
# See config/gemini.example.php for the structure to recreate it.
config/gemini.php

# Google Drive backup upload secret — never track this file.
# See config/gdrive.example.php for the structure to recreate it.
config/gdrive.php

# KYC documents (government ID scans, employment certificates) uploaded by
# Basics applicants — real PII, never committed. The .htaccess deny-all in
# this folder is the one exception, tracked so it always ships with the app.
/uploads/basics_kyc/*
!/uploads/basics_kyc/.htaccess
/uploads/basics_payment_proofs/*
!/uploads/basics_payment_proofs/.htaccess
/uploads/basics_benefit_docs/*
!/uploads/basics_benefit_docs/.htaccess

# Editor/tool-local config, not app code
.claude/

# Purchased/vendor template reference source — the app only uses the copy
# baked into assets/css/theme.css, not these original template files
theme/
